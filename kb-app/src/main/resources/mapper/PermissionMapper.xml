<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhishiku.kb.app.auth.mapper.PermissionMapper">
    <select id="findVisibleSpaceIds" resultType="long">
        SELECT s.id FROM kb_space s
        WHERE (s.archived = false OR #{permission} = 'manage')
        AND <include refid="com.zhishiku.kb.app.authorization.AuthorizationRules.spaceGrant">
            <property name="spaceTable" value="kb_space_acl"/>
            <property name="spaceId" value="s.id"/>
            <property name="permission" value="#{permission}"/>
        </include>
    </select>
</mapper>
