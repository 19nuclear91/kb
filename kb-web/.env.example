# 公开构建配置，不得填写令牌、模型密钥或内部服务凭据。
VITE_CONVERSATION_ENABLED=false
# 可选 Office 只读预览域名：必须是与主站同站点、不同 Origin 的 HTTPS 域名。
# VITE_OFFICE_PREVIEW_ORIGIN=https://preview.example.invalid
# 导航未读数的自动刷新间隔（毫秒），默认 60000，低于 30000 时按 30000 处理。
# VITE_NOTIFICATION_POLL_MS=60000
# 仅供本机开发服务器使用，不进入浏览器产物。
KB_WEB_GATEWAY=http://localhost:8080
