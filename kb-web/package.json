    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@testing-library/user-event": "14.6.8",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "unplugin-element-plus": "0.11.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
